{
  "name": "carwise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node scripts/dotnet.mjs run --project backend/CarWise.Api --no-launch-profile",
    "test": "node --test scripts/check-cloud-tests.mjs scripts/browser-ocr-cancel-tests.mjs && node scripts/browser-payroll-tests.mjs && node scripts/dotnet.mjs test backend/CarWise.Tests --nologo",
    "start": "npm run server",
    "server:build": "node scripts/dotnet.mjs build backend/CarWise.Api --nologo",
    "db:start": "node scripts/dev-db.mjs",
    "db:import": "node scripts/dotnet.mjs run --project backend/CarWise.Api --no-launch-profile -- --import-data",
    "ocr:setup": "node scripts/setup-ocr.mjs",
    "ocr:verify": "node scripts/verify-ocr.mjs",
    "ocr:verify:complex": "node scripts/verify-complex-payslips.mjs",
    "prebuild": "node scripts/browser-ocr-assets.mjs",
    "predev": "node scripts/browser-ocr-assets.mjs",
    "browser-ocr:setup": "node scripts/browser-ocr-assets.mjs",
    "test:browser-payroll": "node scripts/browser-payroll-tests.mjs",
    "verify:innovations": "python3 scripts/verify-innovations.py",
    "verify:fleet": "python3 scripts/verify-fleet.py",
    "verify:intent": "python3 scripts/verify-intent.py",
    "test:e2e": "python3 scripts/test-e2e.py",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "verify:judges": "python3 scripts/test-e2e.py --suite judge-demo",
    "verify:cloud": "node scripts/check-cloud.mjs"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
